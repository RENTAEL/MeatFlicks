{
	"headers": [
		{
			"source": "/_app/immutable/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/service-worker.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache, no-store, max-age=0"
				}
			]
		}
	],
	"crons": [
		{
			"path": "/api/catalog/refresh",
			"schedule": "0 6 * * *"
		}
	]
}
