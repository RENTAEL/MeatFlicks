# https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/
TMDB_POSTER_SIZE=w500
TMDB_BACKDROP_SIZE=original
TMDB_STILL_SIZE=w300

SQLITE_DB_PATH=data/meatflicks.db

# fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Seconds
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=900
CACHE_TTL_LONG=1800
CACHE_MEMORY_MAX_ITEMS=512

# Firebase (for user accounts & cross-device sync)
# Create a project at https://console.firebase.google.com
# Enable Authentication (Email/Password) and Firestore Database
PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
PUBLIC_FIREBASE_APP_ID=your_app_id

# OMDB API (for AggregatedRating — IMDb, RT, Metacritic scores)
# Get a key at http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Open Subtitles API (for auto-subtitles feature)
# Register at https://www.opensubtitles.com/en/users/sign_up
OPEN_SUBTITLES_API_KEY=your_open_subtitles_api_key_here
OPEN_SUBTITLES_USER_AGENT=MeatFlicks

# Trakt.tv (for watch tracking feature)
# Create app at https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here
